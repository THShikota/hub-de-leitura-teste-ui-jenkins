pipeline {
    agent any

    stages {

        stage("Clonar o hub de leitura integrado") {
            steps {
                bat 'git clone https://github.com/THShikota/hub-de-leitura-integrado.git'
            }
        }

        stage("Instalar dependências") {
            steps {
                dir('hub-de-leitura-integrado') {
                    bat 'npm install'
                    bat 'npm start'
                }
            }
        }
    }
}