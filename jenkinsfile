pipeline {
    agent any
    tools { nodejs "nodejs" }

    stages {

        stage("Clonar o hub de leitura integrado") {
            steps {
                bat 'rmdir /s /q hub-de-leitura-integrado'
                bat 'git clone https://github.com/THShikota/hub-de-leitura-integrado.git'
            }
        }

        stage("Instalar dependências") {
            steps {
                dir('hub-de-leitura-integrado') {
                    bat 'npm install'
                    bat 'nohup npm start &'
                }
            }
        }

        stage("Clonar o projeto de teste") {
            steps {
                bat 'rmdir /s /q hub-de-leitura-teste-ui-jenkins'
                bat 'git clone https://github.com/THShikota/hub-de-leitura-teste-ui-jenkins.git'
            }
        }

        stage("Instalar dependências do projeto de testes") {
            steps {
                dir('hub-de-leitura-teste-ui-jenkins') {
                    bat 'npm install'
                }
            }
        }

        stage("Executar testes automatizados") {
            steps {
                dir('hub-de-leitura-teste-ui-jenkins') {
                    bat 'npm test'
                }
            }
        }
    }

    post {
        always {
            bat 'taskkill /F /IM node.exe'
        }
    }
}