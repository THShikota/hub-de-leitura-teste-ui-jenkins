pipeline {
    agent any
    tools { nodejs "nodejs" }

    stages {

        stage("Clonar o hub de leitura integrado") {
            steps {
                bat '''
                    if exist hub-de-leitura-integrado rmdir /s /q hub-de-leitura-integrado
                    git clone --depth 1 https://github.com/THShikota/hub-de-leitura-integrado.git
                '''
            }
        }

        stage("Instalar dependências") {
            steps {
                dir('hub-de-leitura-integrado') {
                    bat '''
                        call npm install
                        start /B npm start
                    '''
                }
            }
        }

        stage("Clonar o projeto de teste") {
            steps {
                bat '''
                    if exist hub-de-leitura-teste-ui-jenkins rmdir /s /q hub-de-leitura-teste-ui-jenkins
                    git clone --depth 1 https://github.com/THShikota/hub-de-leitura-teste-ui-jenkins.git
                '''
            }
        }

        stage("Instalar dependências do projeto de testes") {
            steps {
                dir('hub-de-leitura-teste-ui-jenkins') {
                    bat 'call npm install'
                }
            }
        }

        stage("Executar testes automatizados") {
            steps {
                dir('hub-de-leitura-teste-ui-jenkins') {
                    bat 'npm test'
                }
            }
        }
    }

    post {
        always {
            dir('hub-de-leitura-teste-ui-jenkins') {
                archiveArtifacts artifacts: 'cypress/screenshots/**/*.*,cypress/videos/**/*.*', allowEmptyArchieve: true
                bat 'taskkill /F /IM node.exe || exit 0'
            }
        }
    }
}